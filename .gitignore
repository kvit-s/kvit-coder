# Binaries
/kvit-coder
/kvit-coder-ui
/bin/

# Go build artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.html
.gocache
vendor/

# Logs
*.log

# Local configs
config-local.yaml

# Workspace lock file
.kvit-coder.lock

# Benchmark run outputs. Every benchmark family writes a timestamped report and
# a transcript per run; none of it is an input, and keeping it out of the index
# also keeps it out of ripgrep, which honours this file.
benchmarks/terminal-*.txt
benchmarks/benchmark-*.md
benchmarks/haystack-*.md
benchmarks/thinkbench-*.md
benchmarks/thinkbench-*.json
benchmarks/kvit-coder
benchmarks/.obsidian/

# Benchmark runtime directories (the suites themselves are committed)
benchmarks/.kvit-coder-benchmark/
benchmarks/results/
benchmarks/thinkbench/runs/
benchmarks/thinkbench/results/
benchmarks/thinkbench/.uv/

# The haystack corpus is an amalgamation of this repo's own source, regenerated
# by scripts/amalgamate-go.sh. Tracking it would keep a stale second copy of the
# codebase in every search.
benchmarks/haystacks/*.txt
.clauding

# Working notes that are not part of the program
spec/
